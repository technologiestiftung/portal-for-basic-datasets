        <nav class="lang-switch" aria-label="{{ t.langSwitchLabel }}">
            {% for loc in site.locales %}
            {% assign tt = site.i18n[loc] %}
            <a class="lang-link{% if loc == startpage.locale %} is-active{% endif %}" href="/{{ loc }}/"{% if loc == startpage.locale %} aria-current="true"{% endif %} hreflang="{{ loc }}">{{ loc | upcase }}</a>
            {% endfor %}
        </nav>
      </div>
    <div class="section pb-6 pt-6" id="intro">
        <div id="teaser" style="padding-top:1rem">
        <h1 id="title"><img src="{{ a }}assets/images/logo@2x.png" style="padding-top:26px" alt="{{ t.pageTitle }}">{{ t.pageTitle }}</h1>
    <p class="headline-02b">
        {{ t.subtitle }}
      </p></div>
        <p class="headline-04">{{ t.introHtml }}</p>
    </div>
</header>
<main>
    <div class="grey-bg pt-1">
  <div class="container_list">
      <div id="list">
          <ul>
              {% for dataset in datasets %}
              {% assign dsTitle = dataset.title[startpage.locale] %}
              <li>
                <a href="{{ dataset.url }}" target="_blank" rel="noopener noreferrer">
                    {% if dataset.preview %}
                    <img src="{{ a }}{{ dataset.preview }}" alt="{{ dsTitle }}" />
                    {% else %}
                    <img src="{{ a }}assets/images/file@2x.png" alt="{{ dsTitle }}" />
                    {% endif %}
                    <span class="data-title">{{ dsTitle }}</span>
                    <span class="data-action">
                        {{ t.openDataset }}
                        <svg class="external-link-icon" width="20" height="20" viewBox="0 0 21 20" aria-hidden="true">
                            <g fill="none" stroke="currentColor" stroke-linecap="round">
                                <path stroke-width=".87" d="M14.5 10.718v5.797c0 1.09-.868 1.986-1.944 1.986H3.444c-1.069 0-1.945-.887-1.945-1.986V7.487c0-1.091.868-1.986 1.945-1.986h5.947"></path>
                                <path stroke-linejoin="round" d="M6 14 18 2m.473 7.5v-8h-8"></path>
                            </g>
                        </svg>
                    </span>
                    <hr class="clear" />
                </a>
              </li>
              {% endfor %}
          </ul>
      </div>
    </div>
      <hr class="odclear-half clear" />
  </div>
</main>
